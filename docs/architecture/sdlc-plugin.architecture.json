  "cards": [
    {
      "dot": "cyan",
      "title": "Scope",
      "items": [
        "Claude Code plugin: six stage commands plan → design → build → test → deploy → maintain",
        "Python does the gating; markdown only tells Claude which mechanic to call",
        "Stdlib only, Python 3.11+, no runtime deps"
      ]
    },
    {
      "dot": "emerald",
      "title": "Core components",
      "items": [
        "cli.py dispatches <stage> <action> and returns one JSON dict (ok, reason, next)",
        "stages.py owns new/check/accept for intent, spec and plan",
        "build, testing, deploy, maintain mechanics; hooks.py guards tool calls"
      ]
    },
    {
      "dot": "violet",
      "title": "Primary path",
      "items": [
        "/sdlc:<stage> → commands/*.md → uv run sdlc.py → cli.py",
        "Mechanic reads or writes sdlc/<slug>/ artifacts and raises Blocked on failure",
        "Claude acts on the verdict and commits <stage>(<slug>): ..."
      ]
    }
  ]
