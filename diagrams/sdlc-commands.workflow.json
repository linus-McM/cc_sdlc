  "cards": [
    {
      "dot": "emerald",
      "title": "Order",
      "items": [
        "Each stage commits an artifact under sdlc/<feature>/; the next stage refuses until a human accepts it",
        "Accept is refused until the artifact validates and its stage diagram is fresh"
      ]
    },
    {
      "dot": "amber",
      "title": "Participants",
      "items": [
        "Product owner accepts intent and spec; engineer or tech lead accepts the plan; a release manager sets RELEASE_APPROVAL",
        "Claude runs the commands; sdlc.py returns the verdict; hooks deny edits and the gated release"
      ]
    },
    {
      "dot": "rose",
      "title": "Branches and exceptions",
      "items": [
        "fix on locks test files; test run refuses without a red then green cycle",
        "gate tier needs report, review and a rehearsed rollback; 3 sigma writes a Risk: high intent"
      ]
    }
