      "from": "sigma3",
      "to": "next_intent",
      "label": "propose <metric>",
      "role": "return",
      "variant": "dashed"
    },
    {
      "from": "next_intent",
      "to": "plan",
      "role": "return",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Order",
      "items": [
        "The loop is plan, design, build, test: each stage commits an artifact under sdlc/<feature>/ and the next refuses until it is accepted",
        "The loop is complete when test review passes; deploy and maintain are optional"
      ]
    },
    {
      "dot": "amber",
      "title": "Participants",
      "items": [
        "Claude accepts intent and spec once they validate; the user approves once, at build accept, with intent, requirements and plan in view",
        "Claude runs the commands; sdlc.py returns the verdict; hooks deny protected edits and ask before a gated release"
      ]
    },
    {
      "dot": "rose",
      "title": "Plan fidelity",
      "items": [
        "Every numbered requirement is cited by a numbered plan step; test run refuses a step without a red then green cycle and a planned file never changed",
        "Differences from approved.json are reported as deviations; review.md gives a verdict on every requirement"
      ]
    }
  ]
}
