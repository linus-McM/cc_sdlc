{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "sdlc Plugin: Six Commands",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "plan-design",
        "label": "Plan and design",
        "focus": [
          "plan",
          "accept_intent",
          "design",
          "accept_spec",
          "refused"
        ],
        "note": "Claude writes intent.md and spec.md; only a human accepts, and the next stage refuses until then."
      },
      {
        "id": "build-test",
        "label": "Build and test",
        "focus": [
          "build",
          "accept_plan",
          "hooks",
          "test",
          "no_cycle"
        ],
        "note": "Every step is a red then green cycle in tdd.jsonl; hooks lock tests and protected paths."
      },
      {
        "id": "deploy-maintain",
        "label": "Deploy and maintain",
        "focus": [
          "deploy",
          "release",
          "deploy_check",
          "rollback",
          "maintain",
          "oncall",
          "sigma3",
          "next_intent"
        ],
        "note": "Tiers, rehearsed rollback and RELEASE_APPROVAL gate production; a 3 sigma alarm writes the next intent."
      }
    ]
  },
