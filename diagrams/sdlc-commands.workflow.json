{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "sdlc Plugin: Six Commands",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "plan-design",
        "label": "Plan and design",
        "focus": [
          "plan",
          "design",
          "refused"
        ],
        "note": "Claude writes and accepts intent.md and spec.md once they validate; requirements are numbered."
      },
      {
        "id": "build-test",
        "label": "Build and test",
        "focus": [
          "build",
          "accept_plan",
          "hooks",
          "test",
          "no_cycle"
        ],
        "note": "One approval pins the plan in approved.json; every step is a red then green cycle; test review ends the loop."
      },
      {
        "id": "deploy-maintain",
        "label": "Deploy and maintain (optional)",
        "focus": [
          "deploy",
          "release",
          "deploy_check",
          "rollback",
          "maintain",
          "oncall",
          "sigma3",
          "next_intent"
        ],
        "note": "Optional flows: production asks after a rehearsed rollback; a 3 sigma alarm writes the next intent."
      }
    ]
  },
  "lanes": [
    {
      "id": "humans",
      "label": "User: one approval, optional releases"
    },
    {
      "id": "claude",
      "label": "Claude: commands and agents"
    },
    {
      "id": "mechanics",
      "label": "sdlc.py gates and hooks"
    },
    {
      "id": "exceptions",
      "label": "Refusals and rollback",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "p_plan",
      "label": "1 /sdlc:plan",
      "fromCol": 0,
      "toCol": 0
    },
    {
      "id": "p_design",
      "label": "2 /sdlc:design",
      "fromCol": 1,
      "toCol": 1
    },
    {
      "id": "p_build",
      "label": "3 /sdlc:build",
      "fromCol": 2,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "p_test",
      "label": "4 /sdlc:test",
      "fromCol": 3,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "p_deploy",
      "label": "5 /sdlc:deploy (optional)",
      "fromCol": 4,
      "toCol": 4,
      "variant": "dashed"
    },
    {
      "id": "p_maintain",
      "label": "6 /sdlc:maintain (optional)",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "plan",
    "design",
    "build",
    "test",
    "deploy",
    "maintain"
  ],
  "nodes": [
    {
      "id": "accept_plan",
      "lane": "humans",
      "col": 2,
      "type": "security",
      "label": "Approve plan",
      "sublabel": "the one approval",
      "tag": "approved.json"
    },
    {
      "id": "release",
      "lane": "humans",
      "col": 4,
      "type": "security",
      "label": "Release ask",
      "sublabel": "ask, gate tiers"
    },
    {
      "id": "oncall",
      "lane": "humans",
      "col": 5,
      "type": "frontend",
      "label": "User decides",
      "sublabel": "2 sigma SITREP"
    },
    {
      "id": "plan",
      "lane": "claude",
      "col": 0,
      "type": "frontend",
      "label": "plan new",
      "sublabel": "intent, accepts"
    },
    {
      "id": "design",
      "lane": "claude",
      "col": 1,
      "type": "frontend",
      "label": "design new",
      "sublabel": "numbered R1..Rn"
    },
    {
      "id": "build",
      "lane": "claude",
      "col": 2,
      "type": "backend",
      "label": "build",
      "sublabel": "red then green",
      "tag": "tdd.jsonl"
    },
    {
      "id": "test",
      "lane": "claude",
      "col": 3,
      "type": "backend",
      "label": "test",
      "sublabel": "run, review",
      "tag": "complete"
    },
    {
      "id": "deploy",
      "lane": "claude",
      "col": 4,
      "type": "cloud",
      "label": "deploy",
      "sublabel": "pr, rehearse"
    },
    {
      "id": "maintain",
      "lane": "claude",
      "col": 5,
      "type": "backend",
      "label": "maintain",
      "sublabel": "watch, propose"
    },
    {
      "id": "hooks",
      "lane": "mechanics",
      "col": 2,
      "type": "security",
      "label": "Hooks",
      "sublabel": "deny, ask, sync"
    },
    {
      "id": "deploy_check",
      "lane": "mechanics",
      "col": 4,
      "type": "security",
      "label": "deploy check",
      "sublabel": "tier verdict"
    },
    {
      "id": "next_intent",
      "lane": "exceptions",
      "col": 0,
      "type": "frontend",
      "label": "Next intent.md",
      "sublabel": "back to plan"
    },
    {
      "id": "refused",
      "lane": "exceptions",
      "col": 1,
      "type": "security",
      "label": "Gate refuses",
      "sublabel": "prior unaccepted"
    },
    {
      "id": "no_cycle",
      "lane": "exceptions",
      "col": 3,
      "type": "security",
      "label": "run refused",
      "sublabel": "step not built"
    },
    {
      "id": "rollback",
      "lane": "exceptions",
      "col": 4,
      "type": "messagebus",
      "label": "Rollback",
      "sublabel": "rehearsed first"
    },
    {
      "id": "sigma3",
      "lane": "exceptions",
      "col": 5,
      "type": "security",
      "label": "3 sigma alarm",
      "sublabel": "writes intent"
    }
  ],
  "edges": [
    {
      "from": "plan",
      "to": "design",
      "label": "intent accepted",
      "variant": "emphasis"
    },
    {
      "from": "design",
      "to": "build",
      "label": "spec accepted",
      "variant": "emphasis"
    },
    {
      "from": "build",
      "to": "test",
      "label": "plan approved",
      "variant": "emphasis"
    },
    {
      "from": "test",
      "to": "deploy",
      "label": "complete; optional",
      "variant": "dashed"
    },
    {
      "from": "deploy",
      "to": "maintain",
      "label": "deploy record",
      "variant": "dashed"
    },
    {
      "from": "build",
      "to": "accept_plan",
      "role": "branch",
      "variant": "security",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "from": "deploy",
      "to": "release",
      "role": "branch",
      "variant": "security",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "from": "maintain",
      "to": "oncall",
      "role": "branch",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "from": "hooks",
      "to": "build",
      "role": "branch",
      "variant": "security",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "from": "deploy",
      "to": "deploy_check",
      "role": "branch",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "design",
      "to": "refused",
      "role": "error",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "test",
      "to": "no_cycle",
      "role": "error",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "deploy_check",
      "to": "rollback",
      "role": "error",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "maintain",
      "to": "sigma3",
      "role": "error",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
