{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Archify Stage Documents: Build Order",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "one-step",
        "label": "One TDD step",
        "focus": [
          "test",
          "red",
          "implement",
          "green",
          "sync",
          "commit"
        ],
        "note": "Every one of the ten steps walks this loop; the Python verdicts are the gates."
      },
      {
        "id": "stops",
        "label": "Where a step stops",
        "focus": [
          "red",
          "red_passes",
          "sync",
          "unplanned"
        ],
        "note": "A red that passes means the test is wrong; an unplanned file goes into plan.md or is reverted."
      },
      {
        "id": "close",
        "label": "Closing the build",
        "focus": [
          "commit",
          "simplify"
        ],
        "note": "After step ten: /simplify, a last sync, then the live documents for this feature."
      }
    ]
  },
